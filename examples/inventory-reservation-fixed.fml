// Repair: reserve the last item atomically when making the offer.
// Buyers commit only after an offer; reservation expiry is not modeled.
// Two buyers, one item, no cancellations, failures, restocks, or retries.
type Stock = Available | Reserved
type Outcome = Waiting | Won | Lost
type BuyerState = BuyerState { inventory: Actor<Inventory>, outcome: Outcome }
type BuyerMessage = Start(Actor<Buyer>) | Offer(Actor<Buyer>) | Accepted | Rejected
type InventoryMessage = Probe(Actor<Buyer>) | Commit(Actor<Buyer>)
actor Buyer {
  init(inventory: Actor<Inventory>): BuyerState { BuyerState { inventory: inventory, outcome: Waiting } }
  handle_message(state: BuyerState, message: BuyerMessage): BuyerState {
    match message {
      | Start(reply_to) -> { send(state.inventory, Probe(reply_to)); state }
      | Offer(reply_to) -> { send(state.inventory, Commit(reply_to)); state }
      | Accepted -> BuyerState { inventory: state.inventory, outcome: Won }
      | Rejected -> BuyerState { inventory: state.inventory, outcome: Lost }
    }
  }
}
actor Inventory {
  init(): Stock { Available }
  handle_message(stock: Stock, message: InventoryMessage): Stock {
    match message {
      | Probe(buyer) -> {
          match stock {
            | Available -> { send(buyer, Offer(buyer)); Reserved }
            | Reserved -> { send(buyer, Rejected); Reserved }
          }
        }
      | Commit(buyer) -> { send(buyer, Accepted); Reserved }
    }
  }
}
let outcome = (candidate: Option<BuyerState>): Outcome {
  match candidate { | None -> Waiting | Some(state) -> state.outcome }
}
property "one item cannot be promised to both buyers" {
  always (forall (first in instances(Buyer)) { forall (second in instances(Buyer)) {
    first.reference != second.reference implies !(outcome(first.state) == Won && outcome(second.state) == Won)
  } })
}
property "both buyers can finish" {
  reachable (forall (buyer in instances(Buyer)) { outcome(buyer.state) != Waiting })
}
property "submitted purchases finish" {
  forall (i in inputs(Buyer)) {
    i.submitted leads_to (exists (buyer in instances(Buyer)) { buyer.reference == Some(i.target) && outcome(buyer.state) != Waiting })
  }
}
check LastItem {
  spawn_bound Inventory = 1
  spawn_bound Buyer = 2
  mailbox_bound = 2
  main {
    let inventory = spawn(Inventory);
    let alice = spawn(Buyer, inventory);
    let bob = spawn(Buyer, inventory);
    inputs { once send(alice, Start(alice)) once send(bob, Start(bob)) }
  }
  fairness { weak runtime.progress }
}
