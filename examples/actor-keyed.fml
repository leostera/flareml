// One logical instance per AccountId. No persistence or restart is implied.
type AccountId = Alice | Bob
type Reply = Balance(Int)

let deposit = (owner: Actor<Int>, amount: Int): Reply {
  owner.set(owner.state + amount)
  Balance(owner.state)
}

stateful actor Account(id: AccountId) {
  state: Int = 0
  deposit = deposit
}

let forward = (id: AccountId): Reply {
  let answer = call(Account.at(id).deposit, 1)
  answer
}

stateless actor API { deposit = forward }

invariant "each account is bounded" {
  Account.at(Alice).state <= 1 && Account.at(Bob).state <= 1
}
property "accepted requests complete under fair progress" {
  forall (r in requests(API.deposit)) { r.accepted leads_to r.completed }
}

check Deposits {
  semantics = "actors-v1"
  domain Int = 0..2
  inputs { once API.deposit(Alice) once API.deposit(Bob) }
  fairness { weak runtime.progress }
}
