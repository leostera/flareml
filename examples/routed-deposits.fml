// Transferable addresses route messages without exposing owned account state.
type AccountId = Alice | Bob
type AccountMessage = Deposit(Int)
type Route = Route { target: Address<Account>, amount: Int }
actor Account(id: AccountId) {
  init(id: AccountId): Int { 0 }
  handle_message(state: Int, message: AccountMessage): Int {
    match message { | Deposit(amount) -> state + amount }
  }
}
actor Router {
  handle_message(message: Route): unit { send(message.target, Deposit(message.amount)) }
}
property "accounts are isolated" { always (Account.at(Alice).state <= 1 && Account.at(Bob).state <= 1) }
property "both deposits can finish" { reachable (Account.at(Alice).state == 1 && Account.at(Bob).state == 1) }
property "generated deposits finish" { forall (m in messages(Account)) { m.sent leads_to m.processed } }
check Deposits {
  domain Int = 0..2
  mailbox_bound = 2
  message_bound = 2
  inputs {
    once send(Router, Route { target: Account.at(Alice), amount: 1 })
    once send(Router, Route { target: Account.at(Bob), amount: 1 })
  }
  fairness { weak runtime.progress }
}
