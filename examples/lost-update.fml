// Two clients perform read-modify-write against a storage service.
// Every service turn is atomic; the multi-message transaction is not.
// This is an abstract storage protocol, not a D1 adapter.
type ClientId = Alice | Bob
type Phase = Idle | Reading | Writing | Done
type ClientState = ClientState { me: Actor<Client>, phase: Phase }
type ClientMessage = Start | ReadValue(Int) | Ack
type StoreMessage = Read(Actor<Client>) | Write(Actor<Client>, Int)

actor Client(id: ClientId) {
  init(id: ClientId): ClientState { ClientState { me: Client.at(id), phase: Idle } }
  handle_message(state: ClientState, message: ClientMessage): ClientState {
    match message {
      | Start -> {
          send(Store, Read(state.me));
          ClientState { me: state.me, phase: Reading }
        }
      | ReadValue(value) -> {
          send(Store, Write(state.me, value + 1));
          ClientState { me: state.me, phase: Writing }
        }
      | Ack -> ClientState { me: state.me, phase: Done }
    }
  }
}
actor Store {
  init(): Int { 0 }
  handle_message(state: Int, message: StoreMessage): Int {
    match message {
      | Read(reply_to) -> { send(reply_to, ReadValue(state)); state }
      | Write(reply_to, value) -> { send(reply_to, Ack); value }
    }
  }
}
property "two completed increments retain both updates" {
  always ((Client.at(Alice).state.phase == Done && Client.at(Bob).state.phase == Done) implies Store.state == 2)
}
property "submitted clients finish" {
  forall (id in ClientId) {
    (exists (i in inputs(Client)) { i.target == Client.at(id) && i.submitted })
      leads_to Client.at(id).state.phase == Done
  }
}
check LostUpdate {
  domain Int = 0..2
  mailbox_bound = 2
  inputs { once send(Client.at(Alice), Start) once send(Client.at(Bob), Start) }
  fairness { weak runtime.progress }
}
