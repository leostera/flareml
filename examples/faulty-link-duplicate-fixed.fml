// Repair: the receiver for this request remembers whether it was applied.
// Link choices still permit loss; this proves safety, not eventual delivery.
// Ledger update and application are one atomic turn, not separate external I/O.
type RequestId = Purchase
type Start = Start { link: Actor<Link>, destination: Actor<Receiver> }
type Outcome = Deliver | Drop | Duplicate
type Ledger = Fresh | Recorded
type ReceiverState = ReceiverState { ledger: Ledger, applications: Int, deliveries: Int }
type Packet = Packet { destination: Actor<Receiver>, request: RequestId }
actor Sender {
  handle_message(message: Start): unit {
    send(message.link, Packet { destination: message.destination, request: Purchase });
  }
}
actor Link {
  handle_message(packet: Packet): unit {
    let outcome = choose([Deliver, Drop, Duplicate]);
    match outcome {
      | Deliver -> send(packet.destination, packet.request)
      | Drop -> ()
      | Duplicate -> {
          send(packet.destination, packet.request);
          send(packet.destination, packet.request);
        }
    }
  }
}
actor Receiver {
  init(): ReceiverState { ReceiverState { ledger: Fresh, applications: 0, deliveries: 0 } }
  handle_message(state: ReceiverState, request: RequestId): ReceiverState {
    match state.ledger {
      | Fresh -> ReceiverState { ledger: Recorded, applications: state.applications + 1, deliveries: state.deliveries + 1 }
      | Recorded -> ReceiverState { ledger: Recorded, applications: state.applications, deliveries: state.deliveries + 1 }
    }
  }
}
let applications = (candidate: Option<ReceiverState>): Int {
  match candidate { | None -> 0 | Some(state) -> state.applications }
}
let deliveries = (candidate: Option<ReceiverState>): Int {
  match candidate { | None -> 0 | Some(state) -> state.deliveries }
}
property "one application per request" {
  always (forall (receiver in instances(Receiver)) { applications(receiver.state) <= 1 })
}
property "delivery is possible" { reachable (exists (receiver in instances(Receiver)) { applications(receiver.state) == 1 }) }
property "a duplicate can finish" { reachable (exists (receiver in instances(Receiver)) { deliveries(receiver.state) == 2 }) }
check DuplicatingLink {
  domain Int = 0..2
  mailbox_bound = 2
  spawn_bound Sender = 1
  spawn_bound Link = 1
  spawn_bound Receiver = 1
  main {
    let sender = spawn(Sender);
    let link = spawn(Link);
    let receiver = spawn(Receiver);
    inputs { once send(sender, Start { link: link, destination: receiver }) }
  }
  fairness { weak runtime.progress }
}
