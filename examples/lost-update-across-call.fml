// Two increments read the same value before a remote call and lose an update.
// Historical actors-v1 profile: the call suspends its caller and permits another
// invocation of the SAME key. Unlike actors-v2 message turns, handlers can interleave.
type Key = Shared

type Reply = Done

let pause = (value: Int): Int { value }
stateless actor Remote { echo = pause }

let bump = (owner: Actor<Int>, amount: Int): Reply {
  let old = owner.state
  let ignored = call(Remote.echo, amount)
  owner.set(old + ignored)
  Done
}
stateful actor Counter(id: Key) {
  state: Int = 0
  bump = bump
}

invariant "two completed bumps must not lose one" {
  forall (a in requests(Counter.bump)) {
    forall (b in requests(Counter.bump)) {
      (a != b && a.completed && b.completed) implies Counter.at(Shared).state == 2
    }
  }
}

check LostUpdate {
  semantics = "actors-v1"
  domain Int = 0..2
  inputs { once Counter.at(Shared).bump(1) once Counter.at(Shared).bump(1) }
  fairness { weak runtime.progress }
}
