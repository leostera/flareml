// The repair: ask storage to increment atomically, rather than read then write.
type ClientMessage = Start(Actor<Client>) | Ack
type StoreMessage = Increment(Actor<Client>)
type ClientState = ClientState { store: Actor<Store>, done: Bool }
actor Client {
  init(store: Actor<Store>): ClientState { ClientState { store: store, done: false } }
  handle_message(state: ClientState, message: ClientMessage): ClientState {
    match message {
      | Start(reply_to) -> { send(state.store, Increment(reply_to)); state }
      | Ack -> ClientState { store: state.store, done: true }
    }
  }
}
actor Store {
  init(): Int { 0 }
  handle_message(state: Int, message: StoreMessage): Int {
    match message { | Increment(reply_to) -> { send(reply_to, Ack); state + 1 } }
  }
}
let finished = (candidate: Option<ClientState>): Bool {
  match candidate { | None -> false | Some(state) -> state.done }
}
let both_finished = (): Bool { forall (client in instances(Client)) { finished(client.state) } }
property "two completed increments retain both updates" {
  always (both_finished() implies (forall (store in instances(Store)) { store.state == Some(2) }))
}
property "both increments can finish" { reachable (both_finished()) }
property "submitted clients finish" {
  forall (i in inputs(Client)) {
    i.submitted leads_to (exists (client in instances(Client)) { client.reference == Some(i.target) && finished(client.state) })
  }
}
check AtomicIncrements {
  domain Int = 0..2
  spawn_bound Store = 1
  spawn_bound Client = 2
  mailbox_bound = 2
  main {
    let store = spawn(Store);
    let alice = spawn(Client, store);
    let bob = spawn(Client, store);
    inputs { once send(alice, Start(alice)) once send(bob, Start(bob)) }
  }
  fairness { weak runtime.progress }
}
