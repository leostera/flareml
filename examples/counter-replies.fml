// A counter commits an increment and explicitly sends a correlated reply.
// The client cannot process the reply before that commit.
// Finite, fault-free mailboxes model a protocol, not a deployment runtime or durability.
type RequestId = First
type CounterMessage = Inc(Actor<Client>, RequestId)
type ClientMessage = Counted(RequestId, Int)
type ClientState = Waiting | Observed

actor Counter {
  init(): Int { 0 }
  handle_message(state: Int, message: CounterMessage): Int {
    match message {
      | Inc(reply_to, request_id) -> {
          let next = state + 1;
          send(reply_to, Counted(request_id, next));
          next
        }
    }
  }
}

actor Client {
  init(): ClientState { Waiting }
  handle_message(state: ClientState, message: ClientMessage): ClientState {
    match message {
      | Counted(_, _) -> Observed
    }
  }
}

property "reply cannot be processed before the counter commits" {
  always ((exists (client in instances(Client)) { client.state == Some(Observed) }) implies
    (forall (counter in instances(Counter)) { counter.state == Some(1) }))
}
property "client receives reply" { reachable (exists (client in instances(Client)) { client.state == Some(Observed) }) }

property "submitted increments eventually receive a reply" {
  forall (i in inputs(Counter)) {
    i.submitted leads_to (exists (client in instances(Client)) { client.state == Some(Observed) })
  }
}

property "generated replies are eventually processed" {
  forall (m in messages(Client)) {
    m.sent leads_to m.processed
  }
}

property "a reply was generated internally" {
  reachable (exists (m in messages(Client)) { m.sent && !m.external })
}

check OneIncrement {
  domain Int = 0..1
  mailbox_bound = 2
  message_bound = 2
  spawn_bound Counter = 1
  spawn_bound Client = 1
  main {
    let counter = spawn(Counter);
    let client = spawn(Client);
    inputs { once send(counter, Inc(client, First)) }
  }
  fairness { weak runtime.progress }
}
