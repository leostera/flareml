// Repair: deduplicate by payment key at the atomic charge boundary.
// Two deliveries of payment A, one of distinct payment B. Routing is explicit.
// Ledger update and charge are ONE turn, not a separate external payment API.
// No crashes, lost replies, refunds, or persistence are modeled.
type PaymentId = PaymentA | PaymentB
type Request = Pay(PaymentId, Actor<Gateway>) | Receipt
type Debit = Debit(Actor<Gateway>)
type Ledger = Fresh | Recorded
type Routes = Routes { a: Actor<Processor>, b: Actor<Processor> }
type PaymentState = PaymentState { id: PaymentId, ledger: Ledger, charges: Int, deliveries: Int }
actor Gateway {
  init(a: Actor<Processor>, b: Actor<Processor>): Routes { Routes { a: a, b: b } }
  handle_message(state: Routes, request: Request): Routes {
    match request {
      | Pay(id, reply_to) -> {
          match id { | PaymentA -> send(state.a, Debit(reply_to)) | PaymentB -> send(state.b, Debit(reply_to)) }
        }
      | Receipt -> ()
    };
    state
  }
}
actor Processor {
  init(id: PaymentId): PaymentState { PaymentState { id: id, ledger: Fresh, charges: 0, deliveries: 0 } }
  handle_message(state: PaymentState, request: Debit): PaymentState {
    match request { | Debit(reply_to) -> send(reply_to, Receipt) };
    match state.ledger {
      | Fresh -> PaymentState { id: state.id, ledger: Recorded, charges: state.charges + 1, deliveries: state.deliveries + 1 }
      | Recorded -> PaymentState { id: state.id, ledger: Recorded, charges: state.charges, deliveries: state.deliveries + 1 }
    }
  }
}
let charges = (candidate: Option<PaymentState>): Int {
  match candidate { | None -> 0 | Some(state) -> state.charges }
}
let delivered = (candidate: Option<PaymentState>, id: PaymentId, count: Int): Bool {
  match candidate { | None -> false | Some(state) -> state.id == id && state.deliveries == count }
}
let charged = (candidate: Option<PaymentState>, request: Request): Bool {
  match candidate {
    | None -> false
    | Some(state) -> { match request { | Pay(id, reply_to) -> state.id == id && state.charges >= 1 | Receipt -> false } }
  }
}
property "at most one charge per payment key" {
  always (forall (processor in instances(Processor)) { charges(processor.state) <= 1 })
}
property "distinct payments can both charge" {
  reachable (forall (processor in instances(Processor)) { charges(processor.state) == 1 })
}
property "the duplicate can be fully processed" {
  reachable ((exists (processor in instances(Processor)) { delivered(processor.state, PaymentA, 2) }) &&
    (exists (processor in instances(Processor)) { delivered(processor.state, PaymentB, 1) }))
}
property "submitted payments eventually charge" {
  forall (i in inputs(Gateway)) {
    i.submitted leads_to (exists (processor in instances(Processor)) { charged(processor.state, i.payload) })
  }
}
check DuplicatePayment {
  domain Int = 0..2
  spawn_bound Processor = 2
  spawn_bound Gateway = 1
  mailbox_bound = 3
  main {
    let a = spawn(Processor, PaymentA);
    let b = spawn(Processor, PaymentB);
    let gateway = spawn(Gateway, a, b);
    inputs {
      once send(gateway, Pay(PaymentA, gateway))
      once send(gateway, Pay(PaymentA, gateway))
      once send(gateway, Pay(PaymentB, gateway))
    }
  }
  fairness { weak runtime.progress }
}
