// Forwarding two additions through an API still violates the counter bound.
// Historical actors-v1 synchronous calls suspend callers; no transport faults,
// timeouts, restarts or durability are modeled.
type Reply = Count(Int)

let increment = (owner: Actor<Int>, amount: Int): Reply {
  owner.set(owner.state + amount)
  Count(owner.state)
}

stateful actor Counter {
  state: Int = 0
  add = increment
}

let forward = (amount: Int): Reply {
  let answer = call(Counter.add, amount)
  answer
}

stateless actor API { add = forward }

invariant "counter bound" { Counter.state <= 1 }
property "API replies under fair progress" {
  forall (r in requests(API.add)) { r.accepted leads_to r.completed }
}

check ThroughAPI {
  semantics = "actors-v1"
  domain Int = 0..2
  inputs { once API.add(1) once API.add(1) }
  fairness { weak runtime.progress }
}
