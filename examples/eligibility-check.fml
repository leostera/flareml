// Ordinary pure functions model a policy; one participant applies it.
type Request = Eligible | Ineligible
type Decision = Allowed | Denied
let decide = (request: Request): Decision {
  match request { | Eligible -> Allowed | Ineligible -> Denied }
}
actor Policy {
  init(): Decision { Denied }
  handle_message(state: Decision, request: Request): Decision { decide(request) }
}
property "an ineligible request is denied" { always (Policy.state == Denied) }
property "the policy is exercised" { reachable (exists (i in inputs(Policy)) { i.processed }) }
check Ineligible {
  mailbox_bound = 1
  inputs { once send(Policy, Ineligible) }
  fairness { weak runtime.progress }
}
