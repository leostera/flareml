{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["agents/**/*.ts", "evals/**/*.ts", "judges/**/*.ts", "lib/**/*.ts", "tasks/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "evalkit.config.ts"],
  "exclude": ["node_modules", "_evalkit-results", "_evalkit-campaigns", "_evalkit-evidence", "_evalkit-sandbox", "reports"]
}
